#!/usr/bin/env python3
"""Hyprdrive Omarchy panel back end.

Live preview is `hyprctl keyword`. Durable writes land in
~/.config/hypr/hyprdrive/40-panel.lua (keys) and 35-gestures.lua (gestures).
AC/battery profiles live in ~/.local/state/hyprdrive/panel.json.
"""
from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys

STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))) / "hyprdrive"
STORE = STATE / "panel.json"
FRAGDIR = pathlib.Path(os.environ.get("HYPRDRIVE_FRAGMENTS", os.path.expanduser("~/.config/hypr/hyprdrive")))
PANEL_FRAG = "40-panel.lua"
GESTURE_FRAG = "35-gestures.lua"
BEGIN = "-- BEGIN raw-snippet (hand edits below survive regeneration)"
END = "-- END raw-snippet"

PLUGIN = "plugin:hyprdrive:"

