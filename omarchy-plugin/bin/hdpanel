def _env():
    env = dict(os.environ)
    run = env.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig or not (pathlib.Path(run) / "hypr" / sig / ".socket.sock").exists():
        d = pathlib.Path(run) / "hypr"
        sigs = sorted((p for p in d.glob("*") if (p / ".socket.sock").exists()),
                      key=lambda p: p.stat().st_mtime, reverse=True) if d.is_dir() else []
        if not sigs:
            return None
        env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0].name
    env["XDG_RUNTIME_DIR"] = run
    return env


def hyprctl(*args):
    env = _env()
    if env is None:
        return None
    try:
        r = subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=20, env=env)
    except (OSError, subprocess.SubprocessError):
        return None
    text = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0:
        return None
    if "can't work" in text or text.lstrip().startswith("error:"):
        return None
    return r.stdout


def hyprctl_run(*args):
    env = _env()
    if env is None:
        return None
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=20, env=env)
    except (OSError, subprocess.SubprocessError):
        return None


def getoption(key):
    out = hyprctl("getoption", key, "-j")
    if not out:
        return None
    try:
        d = json.loads(out)
    except ValueError:
        return None
    for k in ("bool", "int", "float", "str", "gradient", "vec2", "css", "custom", "data"):
        if k in d:
            return d[k]
    return None


# Omarchy looknfeel.lua sets these as overridden leaves. animations.enabled
# alone does not clear them, so compositor-off has to disable each one and
# compositor-on has to restore the shipped curves.
OMARCHY_ANIM_LEAVES = [
    ("global", True, 10, "default", None),
    ("border", True, 5.39, "easeOutQuint", None),
    ("windows", True, 3.79, "easeOutQuint", None),
    ("windowsIn", True, 4.1, "easeOutQuint", "popin 87%"),
    ("windowsOut", True, 1.49, "linear", "popin 87%"),
    ("fadeIn", True, 1.73, "almostLinear", None),
    ("fadeOut", True, 1.46, "almostLinear", None),
    ("fade", True, 3.03, "quick", None),
    ("fadeSwitch", False, None, None, None),
    ("layers", True, 3.81, "easeOutQuint", None),
    ("layersIn", True, 4, "easeOutQuint", "fade"),
    ("layersOut", True, 1.5, "linear", "fade"),
    ("fadeLayersIn", True, 1.79, "almostLinear", None),
    ("fadeLayersOut", True, 1.39, "almostLinear", None),
    ("workspaces", False, None, None, None),
    ("specialWorkspace", True, 3, "easeOutQuint", "slidevert"),
]


def eval_lua(code):
    r = hyprctl_run("eval", code)
    if r is None:
        return False
    text = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0 or text.lstrip().startswith("error:"):
        sys.stderr.write(text if text.endswith("\n") else text + "\n")
        return False
    return True


def anim_leaf_lua(leaf, enabled, speed=None, curve=None, style=None):
    fields = ["leaf = %s" % lua_lit(leaf), "enabled = %s" % lua_lit(bool(enabled))]
    if enabled and speed is not None:
        fields.append("speed = %s" % lua_lit(speed))
        if curve:
            fields.append("bezier = %s" % lua_lit(curve))
        if style:
            fields.append("style = %s" % lua_lit(style))
    return "hl.animation({ %s })" % ", ".join(fields)


# Extra leaves Omarchy does not override; disable them explicitly so they
# cannot keep animating via inherit-as-true (internalEnabled -1).
DISABLE_EXTRA_LEAVES = ("windowsMove",)


def compositor_anim_lua(enabled, restore_leaves):
    lines = ["hl.config({ animations = { enabled = %s } })" % lua_lit(bool(enabled))]
    if enabled and restore_leaves:
        for leaf, on, speed, curve, style in OMARCHY_ANIM_LEAVES:
            lines.append(anim_leaf_lua(leaf, on, speed, curve, style))
    elif not enabled:
        for leaf, on, speed, curve, style in OMARCHY_ANIM_LEAVES:
            lines.append(anim_leaf_lua(leaf, False))
        for leaf in DISABLE_EXTRA_LEAVES:
            lines.append(anim_leaf_lua(leaf, False))
    return "\n".join(lines)


def apply_live_many(pairs):
    """Omarchy uses the Lua config parser; hyprctl keyword is a no-op. eval hl.config."""
    anim = None
    rest = []
    for key, value in pairs:
        if key == "animations:enabled":
            anim = bool(value)
        else:
            rest.append((key, value))
    if rest:
        tree = {}
        for key, value in rest:
            nest_set(tree, key, value)
        if not eval_lua("hl.config(%s)" % emit_table(tree, 0)):
            return False
    if anim is not None:
        # Live on must restore leaves because looknfeel.lua is not re-run.
        if not eval_lua(compositor_anim_lua(anim, restore_leaves=True)):
            return False
    return True


def apply_live(key, value):
    return apply_live_many([(key, value)])


def on_battery():
    root = pathlib.Path("/sys/class/power_supply")
    if not root.is_dir():
        return False
    for p in root.iterdir():
        t = (p / "type").read_text().strip() if (p / "type").exists() else ""
        if t == "Mains" and (p / "online").exists():
            return (p / "online").read_text().strip() == "0"
    for p in root.iterdir():
        t = (p / "type").read_text().strip() if (p / "type").exists() else ""
        if t == "Battery" and (p / "status").exists():
            if (p / "status").read_text().strip() == "Discharging":
                return True
    return False


def load_store():
    if STORE.exists():
        try:
            return json.loads(STORE.read_text())
        except ValueError:
            pass
    return {
        "keys": {},
        "gestures": None,
        "profiles": {"ac": {}, "battery": {}},
        "profileMode": "auto",
        "roundedRadius": 24,
    }


def replace_file(path, text):
    """Atomic replace that never widens access (marketplace review, #11012).

    The temp file is CREATED with the destination's mode -- 0600 when there is
    no destination yet -- so a private file is never replaced by a
    umask-default 0644 one. The panel ships on its own (the marketplace copies
    omarchy-plugin/), so this is its own copy of scripts/fragment.py's
    replace_file; scripts/private_modes_test.py checks both."""
    path = pathlib.Path(path)
    try:
        mode = stat.S_IMODE(path.stat().st_mode)
    except FileNotFoundError:
        mode = 0o600
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.unlink(missing_ok=True)  # a leftover temp would keep ITS mode
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.chmod(tmp, mode)  # the umask can only have narrowed it; restore it exactly
    os.replace(tmp, path)


def save_store(s):
    STATE.mkdir(parents=True, exist_ok=True)
    replace_file(STORE, json.dumps(s, indent=1, sort_keys=True) + "\n")


def write_fragment(path, text):
    # Hyprland reloads its whole config (~100 ms stall) on any write under
    # ~/.config/hypr, so leave an unchanged fragment untouched.
    try:
        if path.read_text() == text:
            return
    except OSError:
        pass
    replace_file(path, text)


def lua_lit(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return repr(v) if isinstance(v, float) else str(int(v))
    s = str(v).replace("\\", "\\\\").replace("'", "\\'")
    return "'" + s + "'"


def nest_set(tree, dotted, value):
    parts = dotted.split(":")
    cur = tree
    for p in parts[:-1]:
        cur = cur.setdefault(p, {})
    cur[parts[-1]] = value


def emit_table(obj, indent=8):
    pad = " " * indent
    if isinstance(obj, dict):
        lines = ["{"]
        for k, v in obj.items():
            if isinstance(v, dict):
                lines.append("%s%s = %s," % (pad + "    ", k, emit_table(v, indent + 4)))
            else:
                lines.append("%s%s = %s," % (pad + "    ", k, lua_lit(v)))
        lines.append(pad + "}")
        return "\n".join(lines)
    return lua_lit(obj)


def compose_fragment(machine, existing_path):
    raw = ""
    if existing_path.exists():
        text = existing_path.read_text()
        b = next((i for i, l in enumerate(text.splitlines()) if l.strip().startswith("-- BEGIN raw-snippet")), None)
        if b is not None:
            lines = text.splitlines()
            e = next((i for i in range(b + 1, len(lines)) if lines[i].strip() == END), None)
            if e is not None:
                raw = "\n".join(lines[b + 1:e])
    return machine.rstrip("\n") + "\n\n" + BEGIN + "\n" + raw.strip("\n") + ("\n" if raw.strip("\n") else "") + END + "\n"


def write_panel_fragment(store):
    keys = dict(store.get("keys", {}))
    anim = keys.pop("animations:enabled", None)
    body = [
        "-- hyprdrive fragment 40-panel -- Omarchy settings panel.",
        "-- MACHINE-OWNED above the raw-snippet marker.",
    ]
    # animations.enabled is a compositor key. Keep it (and leaf disables)
    # outside hyprdrive_loaded() so a reload cannot re-enable Omarchy's
    # looknfeel leaves before the plugin guard runs.
    if anim is not None:
        body.append("hl.config({ animations = { enabled = %s } })" % lua_lit(bool(anim)))
        if not anim:
            for leaf, on, speed, curve, style in OMARCHY_ANIM_LEAVES:
                body.append(anim_leaf_lua(leaf, False))
            for leaf in DISABLE_EXTRA_LEAVES:
                body.append(anim_leaf_lua(leaf, False))
    tree = {}
    for k, v in keys.items():
        nest_set(tree, k, v)
    mosaic = mosaic_lua(store)
    if tree or mosaic:
        body.append("if hyprdrive_loaded() then")
        if tree:
            body.append("    hl.config(%s)" % emit_table(tree, 4))
        body.extend("    " + line if line else "" for line in mosaic)
        body.append("end")
    body.append("")
    FRAGDIR.mkdir(parents=True, exist_ok=True)
    path = FRAGDIR / PANEL_FRAG
    write_fragment(path, compose_fragment("\n".join(body), path))
    return path


# ------------------------------------------------------------------ Mosaic
#
# The switch does three things outside hyprdrive's own keys, all of them in
# 40-panel.lua so a reload or a reboot replays them and turning Mosaic off is
# just their absence:
#   - Super+L runs hd-layout-cycle instead of Omarchy's two-way toggle;
#   - with "default" on, general.layout = "mosaic" for every workspace that
#     has no rule of its own;
#   - both sit inside hyprdrive_loaded(), because "mosaic" is a layout only
#     the loaded plugin provides.

def mosaic_state(store):
    """-> (enabled, default). Default without enabled means nothing."""
    keys = store.get("keys", {})
    on = bool(keys.get(MOSAIC_ON, False))
    return on, on and bool(keys.get(MOSAIC_DEFAULT, False))


def mosaic_lua(store):
    on, default = mosaic_state(store)
    lines = []
    if on:
        lines += [
            "",
            "-- Mosaic: Super+L cycles dwindle -> scrolling -> mosaic. A second bind",
            "-- of a chord does not replace the first (both would fire), so drop",
            "-- Omarchy's toggle first -- the unbind-then-bind its bindings.lua",
            "-- template documents. Mosaic off removes these lines, and the next",
            "-- parse binds Omarchy's toggle again untouched.",
            "hl.unbind(%s)" % lua_lit("SUPER + L"),
            "hl.bind(%s, hl.dsp.exec_cmd(%s), { description = %s })" % (
                lua_lit("SUPER + L"), lua_lit(shlex.quote(str(LAYOUT_CYCLE))), lua_lit("Cycle workspace layout")),
        ]
    if default:
        lines += [
            "",
            "-- Mosaic is the default: workspaces with no Super+L choice start in it.",
            "-- Loaded after looknfeel.lua, so this wins; off, looknfeel's stands.",
            "hl.config({ general = { layout = 'mosaic' } })",
        ]
    return lines


def revert_mosaic_workspaces(fallback, chosen_too):
    """Move workspaces off mosaic, live.

    A workspace on mosaic only because it was the default goes back to the
    restored default (`fallback`). One that Super+L put on mosaic has
    Omarchy's state file saying so; with `chosen_too` (Mosaic itself is going
    away) that file, which every parse replays, is rewritten to dwindle -- the
    cycle's first mode and Omarchy's own default -- and the workspace follows.
    Without it (only "default" turned off) a chosen mosaic stays.
    """
    persisted = set()
    if OMARCHY_LAYOUTS.is_dir():
        for f in sorted(OMARCHY_LAYOUTS.glob("*.lua")):
            try:
                text = f.read_text()
            except OSError:
                continue
            if '"mosaic"' not in text:
                continue
            persisted.add(f.stem)
            if chosen_too:
                f.write_text('hl.workspace_rule({ workspace = "%s", layout = "dwindle" })\n' % f.stem)
    try:
        workspaces = json.loads(hyprctl("-j", "workspaces") or "[]")
    except ValueError:
        workspaces = []
    rules = []
    for ws in workspaces:
        wid = str(ws.get("id", ""))
        if ws.get("tiledLayout") != "mosaic" or not wid.lstrip("-").isdigit():
            continue
        if wid in persisted and not chosen_too:
            continue
        layout = "dwindle" if wid in persisted else fallback
        rules.append("hl.workspace_rule({ workspace = %s, layout = %s })" % (lua_lit(wid), lua_lit(layout)))
    if rules:
        eval_lua("\n".join(rules))


def mosaic_before_write(store, before):
    """Bookkeeping that has to happen before 40-panel.lua changes."""
    was_on, was_default = before
    on, default = mosaic_state(store)
    if default and not was_default:
        # Remember what default it displaces, for the live restore below.
        # The durable restore needs no record: looknfeel.lua still sets it.
        cur = getoption("general:layout")
        if isinstance(cur, str) and cur and cur != "mosaic":
            store["mosaicPrevLayout"] = cur
    if (was_on and not on) or (was_default and not default):
        revert_mosaic_workspaces(store.get("mosaicPrevLayout") or "dwindle", chosen_too=was_on and not on)


def mosaic_after_write(store, before):
    """40-panel.lua changed its Mosaic lines: make them live.

    Super+L and general.layout follow from a parse of the config, so this
    reloads explicitly, autoreload or not. MEASURED 2026-10-11: with
    misc:disable_autoreload false, writing 40-panel.lua (a file the config
    `require`s, not hyprland.lua itself) did NOT re-parse -- Mosaic was on, the
    fragment had the new Super+L, and Hyprland kept Omarchy's bind until an
    explicit `hyprctl reload`. One ~100 ms hitch, and only when Mosaic's own
    switches change.
    """
    if mosaic_state(store) == before:
        return
    hyprctl("reload")
    was_default = before[1]
    if was_default and not mosaic_state(store)[1]:
        # The reload re-reads looknfeel.lua's layout; this covers the moment
        # until it lands, and a session where it does not.
        prev = store.get("mosaicPrevLayout") or "dwindle"
        eval_lua("hl.config({ general = { layout = %s } })" % lua_lit(prev))


def commit_store(store, before):
    """Save the store and 40-panel.lua, with Mosaic's side effects around it."""
    mosaic_before_write(store, before)
    save_store(store)
    write_panel_fragment(store)
    mosaic_after_write(store, before)


def lua_direction(direction):
    d = str(direction or "up")
    return DIR_ALIASES.get(d, d)


def hyprland_direction(direction):
    # Hyprland 0.56.2 labels scale<1 as PINCH_OUT (fingers together). Swap so
    # the panel's pinchin/pinchout match what the user actually does.
    d = lua_direction(direction)
    if d == "pinchin":
        return "pinchout"
    if d == "pinchout":
        return "pinchin"
    return d


def gesture_fields(g, include_arg=True):
    fields = [
        "fingers = %d" % int(g.get("fingers", 3)),
        "direction = %s" % lua_lit(hyprland_direction(g.get("direction", "up"))),
        "action = %s" % lua_lit(g.get("action", "overview")),
    ]
    if g.get("mods"):
        fields.append("mods = %s" % lua_lit(g["mods"]))
    if include_arg and g.get("arg"):
        fields.append("arg = %s" % lua_lit(g["arg"]))
    scale = g.get("scale", 1)
    if scale not in (1, 1.0):
        fields.append("scale = %s" % lua_lit(scale))
    if g.get("disable_inhibit"):
        fields.append("disable_inhibit = true")
    return fields


def write_gesture_fragment(gestures):
    native, plugin, workspace = [], [], []
    for g in gestures:
        action = str(g.get("action") or "overview")
        direction = str(g.get("direction") or "")
        if direction in ("click", "tap"):
            plugin.append(g)
        elif action == "workspace":
            workspace.append(g)
        elif action in NATIVE_ACTIONS:
            native.append(g)
        else:
            plugin.append(g)

    lines = [
        "-- hyprdrive fragment 35-gestures -- panel-owned trackpad gestures.",
        "-- Native Hyprland actions (close, fullscreen, ...) use hl.gesture.",
        "-- Overview follow and workspace (overview pan + desktop swipe) stay on hyprdrive.gesture.",
        "-- MACHINE-OWNED above the raw-snippet marker.",
    ]
    for g in native:
        lines.append("pcall(function() hl.gesture({ %s }) end)" % ", ".join(gesture_fields(g, include_arg=bool(g.get("arg")))))
    if workspace:
        lines.append("if hyprdrive_loaded() then")
        for g in workspace:
            lines.append("    pcall(function() hl.plugin.hyprdrive.gesture({ %s }) end)" % ", ".join(gesture_fields(g)))
        lines.append("else")
        for g in workspace:
            lines.append("    pcall(function() hl.gesture({ %s }) end)" % ", ".join(gesture_fields(g, include_arg=False)))
        lines.append("end")
    if plugin:
        lines.append("if hyprdrive_loaded() then")
        for g in plugin:
            lines.append("    pcall(function() hl.plugin.hyprdrive.gesture({ %s }) end)" % ", ".join(gesture_fields(g)))
        lines.append("end")
    lines.append("")
    FRAGDIR.mkdir(parents=True, exist_ok=True)
    path = FRAGDIR / GESTURE_FRAG
    write_fragment(path, compose_fragment("\n".join(lines), path))
    return path


def coerce(meta, value):
    kind = meta["kind"]
    if kind == "bool":
        if isinstance(value, bool):
            return value
        return str(value).strip().lower() in ("1", "true", "yes", "on")
    if kind == "int":
        return int(float(value))
    if kind == "float":
        return float(value)
    if kind == "enum":
        v = str(value)
        if meta.get("options") and v not in [o["value"] for o in meta["options"]]:
            raise SystemExit("hdpanel: %s must be one of %s" % (meta["key"], ", ".join(o["value"] for o in meta["options"])))
        return v
    return str(value)


def live_keys():
    """Every panel key's live value in ONE hyprctl call (--batch), ~4 ms
    instead of one process per key."""
    out = {}
    batch = "; ".join("j/getoption %s" % m["key"] for m in KEY_META)
    text = hyprctl("--batch", batch)
    if text:
        dec = json.JSONDecoder()
        i = 0
        while i < len(text):
            while i < len(text) and text[i] in " \t\r\n":
                i += 1
            if i >= len(text):
                break
            try:
                d, i = dec.raw_decode(text, i)
            except ValueError:
                # "no such option" (a key this Hyprland or plugin build does
                # not have) is plain text in the stream: skip to the next object.
                nxt = text.find("{", i + 1)
                if nxt < 0:
                    break
                i = nxt
                continue
            if not isinstance(d, dict) or "option" not in d:
                continue
            for k in ("bool", "int", "float", "str", "gradient", "vec2", "css", "custom", "data"):
                if k in d:
                    out[d["option"]] = d[k]
                    break
    if not out:  # a Hyprland without --batch: the slow path
        for meta in KEY_META:
            v = getoption(meta["key"])
            if v is not None:
                out[meta["key"]] = v
    return out


def monitor_options(current):
    """dock:monitor's choices: every monitor plus "All", made when the panel
    loads because they are whatever is plugged in. A monitor is stored by
    description (desc:...), which survives a USB-C dock renaming DP-5 to DP-6.
    A chosen monitor that is unplugged stays listed so the choice still shows."""
    opts = [{"value": "", "label": "All"}]
    try:
        mons = json.loads(hyprctl("-j", "monitors") or "[]")
    except ValueError:
        mons = []
    for m in sorted(mons, key=lambda m: (m.get("x", 0), m.get("y", 0))):
        desc, name = (m.get("description") or "").strip(), m.get("name") or ""
        if name.startswith("eDP"):
            label = "Built-in"
        else:
            label = (m.get("model") or "").strip() or name
        value = "desc:" + desc if desc else name
        opts.append({"value": value, "label": label})
    if current and current not in [o["value"] for o in opts]:
        gone = current[5:] if current.startswith("desc:") else current
        opts.append({"value": current, "label": gone.split(" 0x")[0][:24] + " (unplugged)"})
    return opts


def dump():
    store = load_store()
    live = live_keys()
    # Hyprlang reports an empty string option as [[EMPTY]].
    mon_key = PLUGIN + "dock:monitor"
    if live.get(mon_key) == "[[EMPTY]]":
        live[mon_key] = ""
    meta = [dict(m, options=monitor_options(live.get(mon_key, ""))) if m["key"] == mon_key else m for m in KEY_META]
    gestures = store.get("gestures")
    if not gestures:
        gestures = [dict(g) for g in DEFAULT_GESTURES]
    else:
        gestures = [dict(g) for g in gestures]
        seen = {(int(g.get("fingers", 0)), str(g.get("direction") or "")) for g in gestures}
        for g in DEFAULT_GESTURES:
            if g["direction"] == "click" and (g["fingers"], "click") not in seen:
                gestures.append(dict(g))
    version = ""
    try:
        # Beside the copied panel (plugins/dragos.hyprdrive/manifest.json), or at
        # the repository root when this runs from a checkout -- a marketplace
        # install or a dev tree, where hdpanel sits in omarchy-plugin/bin/.
        here = pathlib.Path(__file__).resolve().parent.parent
        mf = next((p for p in (here / "manifest.json", here.parent / "manifest.json") if p.is_file()), None)
        version = json.loads(mf.read_text()).get("version", "") if mf else ""
    except (OSError, ValueError):
        pass
    return {
        "version": version,
        "keys": live,
        "owned": store.get("keys", {}),
        "gestures": gestures,
        "gesturesOwned": store.get("gestures") is not None,
        "profiles": store.get("profiles", {"ac": {}, "battery": {}}),
        "profileMode": store.get("profileMode", "auto"),
        "roundedRadius": store.get("roundedRadius", 24),
        "onBattery": on_battery(),
        "meta": meta,
        "actions": ACTIONS,
        "directions": DIRECTIONS,
    }


def cmd_dump(_args):
    json.dump(dump(), sys.stdout, indent=1)
    sys.stdout.write("\n")
    return 0


def set_keys(pairs, preview=False):
    coerced = []
    for key, value in pairs:
        meta = next((m for m in KEY_META if m["key"] == key), None)
        if meta is None:
            raise SystemExit("hdpanel: unknown key %s" % key)
        coerced.append((key, coerce(meta, value)))
    store = load_store()
    asked = dict(coerced)
    # Mosaic off takes "Mosaic is the default" with it, and the default cannot
    # be switched on by itself: it would set a layout Super+L cannot leave
    # through Mosaic's cycle.
    if asked.get(MOSAIC_ON) is False and MOSAIC_DEFAULT not in asked:
        coerced.append((MOSAIC_DEFAULT, False))
    if asked.get(MOSAIC_DEFAULT) is True and not asked.get(MOSAIC_ON, mosaic_state(store)[0]):
        raise SystemExit("hdpanel: turn Mosaic on before making it the default")
    if not apply_live_many(coerced):
        raise SystemExit("hdpanel: live apply failed")
    if preview:
        return coerced
    before = mosaic_state(store)
    store.setdefault("keys", {})
    for key, value in coerced:
        store["keys"][key] = value
        if key == PLUGIN + "dock:corner_radius" and int(value) > 0:
            store["roundedRadius"] = int(value)
    commit_store(store, before)
    return coerced


def cmd_set(args):
    if len(args) < 2 or len(args) % 2 != 0:
        raise SystemExit("hdpanel: set KEY VALUE [KEY VALUE ...]")
    pairs = list(zip(args[0::2], args[1::2]))
    coerced = set_keys(pairs, preview=False)
    print(json.dumps({"ok": True, "keys": {k: v for k, v in coerced}}))
    return 0


def cmd_preview(args):
    if len(args) < 2 or len(args) % 2 != 0:
        raise SystemExit("hdpanel: preview KEY VALUE [KEY VALUE ...]")
    pairs = list(zip(args[0::2], args[1::2]))
    coerced = set_keys(pairs, preview=True)
    print(json.dumps({"ok": True, "preview": True, "keys": {k: v for k, v in coerced}}))
    return 0


def default_of(meta):
    return meta.get("default")


def reset_keys(store, group):
    """A group's keys back to their defaults, live, and out of the store."""
    metas = [m for m in KEY_META if m.get("group") == group and default_of(m) is not None]
    if not metas:
        return
    pairs = [(m["key"], coerce(m, default_of(m))) for m in metas]
    apply_live_many(pairs)
    before = mosaic_state(store)
    owned = store.setdefault("keys", {})
    for key, _ in pairs:
        owned.pop(key, None)
    commit_store(store, before)


def cmd_reset(args):
    """Restore one panel section to hyprdrive's shipped values.

    The section's keys go back to their defaults live AND leave the store, so
    40-panel.lua stops owning them and a later hyprdrive default change is
    picked up instead of a frozen copy of today's.
    """
    if not args:
        raise SystemExit("hdpanel: reset GROUP")
    group = args[0]
    if group == "gestures":
        store = load_store()
        store["gestures"] = None
        save_store(store)
        write_gesture_fragment([dict(g) for g in DEFAULT_GESTURES])
        # The section's switches too, written before the reload re-reads them.
        reset_keys(store, group)
        if hyprctl("reload") is None:
            raise SystemExit("hdpanel: wrote gestures but hyprctl reload failed")
        print(json.dumps({"ok": True, "group": group}))
        return 0
    metas = [m for m in KEY_META if m.get("group") == group and default_of(m) is not None]
    if not metas:
        raise SystemExit("hdpanel: nothing to reset in %s" % group)
    pairs = [(m["key"], coerce(m, default_of(m))) for m in metas]
    if not apply_live_many(pairs):
        raise SystemExit("hdpanel: live reset failed")
    store = load_store()
    before = mosaic_state(store)
    owned = store.setdefault("keys", {})
    for key, _ in pairs:
        owned.pop(key, None)
    if group == "dock":
        store["roundedRadius"] = 24
    commit_store(store, before)
    print(json.dumps({"ok": True, "group": group, "keys": {k: v for k, v in pairs}}))
    return 0


def cmd_gestures_set(args):
    raw = args[0] if args else sys.stdin.read()
    gestures = json.loads(raw)
    if not isinstance(gestures, list):
        raise SystemExit("hdpanel: gestures-set expects a JSON array")
    for g in gestures:
        if isinstance(g, dict) and g.get("direction"):
            g["direction"] = lua_direction(g["direction"])
    store = load_store()
    store["gestures"] = gestures
    save_store(store)
    write_gesture_fragment(gestures)
    # Re-parse so native hl.gesture and hyprdrive.gesture replace the previous map.
    if hyprctl("reload") is None:
        raise SystemExit("hdpanel: wrote gestures but hyprctl reload failed")
    print(json.dumps({"ok": True, "count": len(gestures)}))
    return 0


def profile_key(key):
    meta = next((m for m in KEY_META if m["key"] == key), None)
    return meta is not None and meta.get("group") not in PROFILE_SKIP


def snapshot_keys():
    live = live_keys()
    store = load_store()
    live.update(store.get("keys", {}))
    return {k: v for k, v in live.items() if profile_key(k)}


def cmd_profile_save(args):
    name = args[0]
    if name not in ("ac", "battery"):
        raise SystemExit("hdpanel: profile is ac or battery")
    store = load_store()
    store.setdefault("profiles", {})[name] = snapshot_keys()
    save_store(store)
    print(json.dumps({"ok": True, "profile": name, "keys": len(store["profiles"][name])}))
    return 0


def apply_profile(name):
    store = load_store()
    prof = store.get("profiles", {}).get(name) or {}
    if not prof:
        return 0
    pairs = []
    for k, v in prof.items():
        meta = next((m for m in KEY_META if m["key"] == k), None)
        if meta is None or meta.get("group") in PROFILE_SKIP:
            continue
        v = coerce(meta, v)
        pairs.append((k, v))
        store.setdefault("keys", {})[k] = v
    if pairs and not apply_live_many(pairs):
        raise SystemExit("hdpanel: profile apply failed")
    save_store(store)
    write_panel_fragment(store)
    return len(pairs)


def cmd_profile_apply(args):
    name = args[0]
    if name == "auto":
        name = "battery" if on_battery() else "ac"
    n = apply_profile(name)
    print(json.dumps({"ok": True, "profile": name, "applied": n, "onBattery": on_battery()}))
    return 0


def cmd_profile_auto(_args):
    """The closed panel's power watcher: apply the matching profile, but only
    in auto mode -- a forced AC/battery choice is left alone."""
    store = load_store()
    if store.get("profileMode", "auto") != "auto":
        print(json.dumps({"ok": True, "skipped": "mode is %s" % store.get("profileMode")}))
        return 0
    name = "battery" if on_battery() else "ac"
    n = apply_profile(name)
    print(json.dumps({"ok": True, "profile": name, "applied": n}))
    return 0


def cmd_profile_mode(args):
    mode = args[0]
    if mode not in ("auto", "ac", "battery"):
        raise SystemExit("hdpanel: profile-mode is auto, ac, or battery")
    store = load_store()
    store["profileMode"] = mode
    save_store(store)
    if mode == "auto":
        apply_profile("battery" if on_battery() else "ac")
    else:
        apply_profile(mode)
    print(json.dumps({"ok": True, "profileMode": mode, "onBattery": on_battery()}))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print("hdpanel dump|set|preview|reset GROUP|gestures-set|profile-save|profile-apply|profile-mode")
        return 0
    cmd = argv[1]
    args = argv[2:]
    fn = {
        "dump": cmd_dump,
        "set": cmd_set,
        "preview": cmd_preview,
        "gestures-set": cmd_gestures_set,
        "profile-save": cmd_profile_save,
        "profile-apply": cmd_profile_apply,
        "profile-mode": cmd_profile_mode,
        "reset": cmd_reset,
        "profile-auto": cmd_profile_auto,
    }.get(cmd)
    if not fn:
        raise SystemExit("hdpanel: unknown command %s" % cmd)
    return fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
